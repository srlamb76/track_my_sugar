{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.4.72"}
        org.xerial/sqlite-jdbc {:mvn/version "3.54.1.0"}
        ring/ring-core {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        compojure/compojure {:mvn/version "1.7.2"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.slf4j/slf4j-nop {:mvn/version "2.0.20"}}
 :aliases
 {:run {:main-opts ["-m" "track-my-sugar.server"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ring/ring-mock {:mvn/version "0.6.2"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.5" :git/sha "2a21b7a"}}
          :ns-default build}}}
